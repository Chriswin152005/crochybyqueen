# Copy this file to .env before running the app

# SQLite for local dev. For production, use a real Postgres URL instead
# (Railway, Supabase, and Neon all give you one for free) and change the
# provider in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Any long random string — used to sign login sessions and video playback tokens.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-this-with-a-long-random-string"

# --- Fill these in when you're ready to go live ---

# Razorpay (recommended for India — UPI, cards, netbanking all supported)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Cloudflare Stream (recommended for tutorial video hosting)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
